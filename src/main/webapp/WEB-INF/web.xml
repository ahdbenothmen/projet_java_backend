<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

  <display-name>Universite Backend</display-name>

  <!-- CORS Filter -->
  <filter>
    <filter-name>CorsFilter</filter-name>
    <filter-class>com.universite.config.CorsFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>CorsFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <!-- Inscription Servlet -->
  <servlet>
    <servlet-name>InscriptionServlet</servlet-name>
    <servlet-class>com.universite.servlet.InscriptionServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>InscriptionServlet</servlet-name>
    <url-pattern>/etudiants/inscription</url-pattern>
  </servlet-mapping>

  <!-- Login Servlet -->
  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.universite.servlet.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/etudiants/login</url-pattern>
  </servlet-mapping>
<!-- Prerequis -->
<servlet>
  <servlet-name>PrerequisServlet</servlet-name>
  <servlet-class>com.universite.servlet.PrerequisServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>PrerequisServlet</servlet-name>
  <url-pattern>/prerequis</url-pattern>
</servlet-mapping>

<!-- Inscription module -->
<servlet>
  <servlet-name>InscriptionModuleServlet</servlet-name>
  <servlet-class>com.universite.servlet.InscriptionModuleServlet</servlet-class>
</servlet>
<servlet-mapping>
  <servlet-name>InscriptionModuleServlet</servlet-name>
  <url-pattern>/inscription-module</url-pattern>
</servlet-mapping>
</web-app>